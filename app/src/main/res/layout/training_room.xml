<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/training_room">

    <Button
        android:id="@+id/begin_training_button"
        android:layout_width="148dp"
        android:layout_height="79dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#B74E4848"
        android:text="Begin Training"
        app:layout_constraintBottom_toTopOf="@+id/select_trainee_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/select_trainee_button"
        android:layout_width="148dp"
        android:layout_height="79dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#B74E4848"
        android:text="Select Trainee"
        app:layout_constraintBottom_toTopOf="@+id/select_difficulty_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/select_difficulty_button"
        android:layout_width="148dp"
        android:layout_height="79dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#B74E4848"
        android:text="Select Difficulty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/training_room_text"
        android:layout_width="179dp"
        android:layout_height="45dp"
        android:layout_marginTop="20dp"
        android:text="Training Room"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/current_trainee_text"
        android:layout_width="112dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:text="Current Trainee"
        android:textColor="#FDFDFD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/training_room_text" />

    <TextView
        android:id="@+id/trainee_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="placeholder name"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/current_trainee_text" />
</androidx.constraintlayout.widget.ConstraintLayout>